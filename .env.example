# Template only. Copy it to .env for local use. .env is listed in .gitignore,
# so it never reaches GitHub, and Jekyll never publishes files that start
# with a dot.
#
# This site needs no secrets: GitHub Pages builds it without any keys.
# If you ever add something that needs one (analytics, a form service),
# keep the real value in .env or in a GitHub Actions secret, never in
# _config.yml, a layout, a data file, or this file.

# Local preview only. GitHub Pages always builds in production mode.
JEKYLL_ENV=development

# Example of the pattern, with a dummy value. Not a real key.
# EXAMPLE_API_KEY=replace-me
